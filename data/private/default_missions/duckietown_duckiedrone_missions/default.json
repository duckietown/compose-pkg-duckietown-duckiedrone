{
    "_data": {
        "blocks": [
            {
                "shape": {
                    "rows": 1,
                    "cols": 3
                },
                "renderer": "Duckiedrone_Heartbeat",
                "title": "Joystick Heartbeat",
                "subtitle": "/joystick/heartbeat",
                "args": {
                    "ros_hostname": "",
                    "topic": "~/joystick/heartbeat",
                    "frequency": 5,
                    "background_color": "#fff"
                }
            },
            {
                "shape": {
                    "rows": 1,
                    "cols": 3
                },
                "renderer": "Duckiedrone_Heartbeats_Monitor",
                "title": "Heartbeats Monitor",
                "subtitle": "/heartbeat/*",
                "args": {
                    "ros_hostname": "",
                    "topic1": "~/joystick/heartbeat",
                    "label1": "JOYSTICK",
                    "topic2": "~/altitude_node/heartbeat",
                    "label2": "ALTITUDE",
                    "topic3": "~/state_estimator_node/heartbeat",
                    "label3": "STATE",
                    "topic4": "~/pid_controller_node/heartbeat",
                    "label4": "PID",
                    "threshold": 2,
                    "frequency": 2,
                    "background_color": "#fff"
                }
            },
			{
				"shape": {
					"rows": 2,
					"cols": 8
				},
				"renderer": "Duckiedrone_Control",
				"title": "Remote Control",
				"subtitle": "Control the drone using a virtual joystick",
				"args": {
					"ros_hostname": "",
                    "service_set_mode": "",
                    "arming_service": "/mavros\/cmd\/arming",
					"service_override_commands": "",
                    "param_override_prefix": "",
                    "topic_mode_current": "/mavros\/state",
                    "topic_control": "/mavros\/manual_control\/send",
                    "topic_commands": "/mavros\/manual_control\/send",
					"frequency": 30,
					"max_roll_pitch": 300,
					"min_value": 1000,
					"max_value": 2000,
					"background_color": "#fff"
				}
			},
            {
                "shape": {
                    "rows": 2,
                    "cols": 3
                },
                "renderer": "Mavros_Arming",
                "title": "Arm / Disarm",
                "subtitle": "WARNING: This will activate the propellers",
                "args": {
                    "ros_hostname": "",
                    "arming_service": "/mavros\/cmd\/arming",
                    "kill_switch": "/mavros\/cmd\/command",
					"set_mode_service": "/mavros\/set_mode",
					"state_topic": "/mavros\/state",
                    "frequency": 10,
                    "background_color": "#fff"
                }
            },
            {
                "shape": {
                    "rows": 2,
                    "cols": 5
                },
                "renderer": "SensorMsgs_Range",
                "title": "Altitude",
                "subtitle": "/altitude_node/altitude",
                "args": {
                    "ros_hostname": "",
                    "topic": "~/altitude_node/altitude",
                    "reference": "~/pid_controller_node/desired/height",
                    "label": "Altitude",
                    "fps": 5,
                    "rendering": "plot"
                }
            },
            {
                "shape": {
                    "rows": 1,
                    "cols": 3
                },
                "renderer": "SensorMsgs_Range",
                "title": "Time-of-Flight",
                "subtitle": "/bottom_tof_driver_node/range",
                "args": {
                    "ros_hostname": "",
                    "topic": "~/bottom_tof_driver_node/range",
                    "fps": 5,
                    "rendering": "number"
                }
            },
            {
                "shape": {
                    "rows": 2,
                    "cols": 8
                },
                "renderer": "Duckiedrone_IMU_Orientation",
                "title": "IMU - Orientation",
                "subtitle": "/mavros/imu/data",
                "args": {
                    "ros_hostname": "",
                    "topic": "/mavros/imu/data",
                    "gyro_service": "/px4_calibration/calibrate_gyro",
                    "accel_service": "/px4_calibration/calibrate_accel",
                    "status_topic": "/px4_calibration/status",
                    "fps": 5
                }
            },
            {
                "shape": {
                    "rows": 4,
                    "cols": 8
                },
                "renderer": "SensorMsgs_CompressedImage",
                "title": "Camera",
                "subtitle": "/camera_node/image/compressed",
                "args": {
                    "ros_hostname": "",
                    "topic": "~/camera_node/image/compressed",
                    "fps": 2,
                    "position": "center center",
                    "style": "cover",
                    "background_color": ""
                }
            }
        ]
    }
}
